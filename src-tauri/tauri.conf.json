{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestión",
  "version": "0.1.32",
  "identifier": "com.nexusgestion.gestion",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://gestion-nexusgestion.vercel.app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gestión",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../print-agent/agente-impresion.ps1": "agente-impresion.ps1"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"]
      }
    }
  }
}
